package kics.aws.appflow_flow\n\n# Rule to detect enabled data_transfer_api for Salesforce connector\n\nviolation[{\"msg\": msg}] {\n  resource := input.resource\n  resource.type == \"aws_appflow_flow\"\n  some i\n  destination := resource.values.destination_flow_config[i]\n  salesforce := destination.destination_connector_properties.salesforce\n  salesforce.data_transfer_api != null\n  msg := sprintf(\"Salesforce data_transfer_api is enabled (value: %v), which may lead to unintended data exfiltration.\", [salesforce.data_transfer_api])\n}