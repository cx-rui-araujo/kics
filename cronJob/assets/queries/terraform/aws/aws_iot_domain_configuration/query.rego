{"id":"TG_AWS_IOT_DOMAIN_SECURE_PR","file":"aws_iot_domain_configuration_secure_protocol.rego","severity":"MEDIUM","type":"VIOLATION","metadata":{"provider":"AWS","service":"IOT","short_code":"secure-domain-configuration","recommended_actions":["Use secure protocol ('MQTTS') and authentication_type ('SIGV4')"],"reference":"https://docs.aws.amazon.com/iot/latest/developerguide/custom-domains.html"},"source":"package terraform.aws_iot\n\nviolation[resource] {\n  resource := input.resource_changes[_]\n  resource.type == \"aws_iot_domain_configuration\"\n  attrs := resource.change.after\n  not attrs.application_protocol\n  attrs.application_protocol != \"MQTTS\"\n}\n\nviolation[resource] {\n  resource := input.resource_changes[_]\n  resource.type == \"aws_iot_domain_configuration\"\n  attrs := resource.change.after\n  not attrs.authentication_type\n  attrs.authentication_type != \"SIGV4\"\n}"}